%header%

DESCRIPTION = "Expression grammar used in the OutSystems Formula component"
AUTHOR      = "Caio Santana Magalhães"
VERSION     = "1.0"
DATE        = "May 2026"

GRAMMARTYPE   = "LL"
CASESENSITIVE = "False"

LICENSE = "This library is free software; you can redistribute it and/or
           modify it under the terms of the GNU Lesser General Public License
           as published by the Free Software Foundation; either version 2.1
           of the License, or (at your option) any later version.

           This library is distributed in the hope that it will be useful,
           but WITHOUT ANY WARRANTY; without even the implied warranty of
           MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
           Lesser General Public License for more details.

           You should have received a copy of the GNU Lesser General Public
           License along with this library; if not, write to the Free
           Software Foundation, Inc., 59 Temple Place, Suite 330, Boston,
           MA 02111-1307, USA.
"

COPYRIGHT = "Copyright (c) 2026 Caio Santana Magalhães"

%tokens%
ADD                          = "+"
SUB                          = "-"
MUL                          = "*"
DIV                          = "/"
LEFT_PAREN                   = "("
RIGHT_PAREN                  = ")"
LEFT_BRACE                   = "["
RIGHT_BRACE                  = "]"
EQ                           = "="
LT                           = "<"
GT                           = ">"
LTE                          = "<="
GTE                          = ">="
NE                           = "<>"
AND                          = "AND"
OR                           = "OR"
NOT                          = "NOT"
IN                           = "IN"
LIKE                         = "LIKE"
MATCH                        = "MATCH"
CONTAINS                     = "CONTAINS"
ANY                          = "ANY"
ALL                          = "ALL"
DOT                          = "."
ARGUMENT_SEPARATOR           = ","
ARRAY_BRACES                 = "[]"
SINGLE_LINE_COMMENT          = <<//.*>> %ignore%
MULTI_LINE_COMMENT           = <</\*([^*]|\*+[^*/])*\*+/>> %ignore%
WHITESPACE                   = <<\s+>> %ignore%

// Primitives
INTEGER                      = <<\d+(u|l|ul|lu)?>>
REAL                         = <<\d*\.\d+([e][+-]\d{1,3})?f?>>
STRING_LITERAL               = <<"([^"\r\n\\]|\\u[0-9a-f]{4}|\\[\\"'trn])*"|'([^'\r\n\\]|\\u[0-9a-f]{4}|\\[\\"'trn])*'>>
TRUE                         = "True"
FALSE                        = "False"
DATETIME                     = <<#\d{4}-\d?\d-\d?\d \d?\d:\d?\d:\d?\d#>>
DATE                         = <<#\d{4}-\d?\d-\d?\d#>>
TIME                         = <<#\d?\d:\d?\d:\d?\d#>>
REGEXP                       = <</([^/\\\r\n]|\\.)+/[gimsuy]*>>
IDENTIFIER                   = <<@?@?[a-z_]\w*>>

// Special Functions
IF                           = "if"

%productions%

Expression = OrExpression;

OrExpression = AndExpression {OR AndExpression};

AndExpression = NotExpression {AND NotExpression};

NotExpression = NOT? SqlOpExpression;

SqlOpExpression = CompareExpression [SqlOpRhs];

SqlOpRhs = InRhs
         | LikeRhs
         | MatchRhs
         | ContainsRhs
         | (NOT NegatedSqlOpRhs);

NegatedSqlOpRhs = InRhs
                | LikeRhs
                | MatchRhs
                | ContainsRhs;

InRhs = IN InTargetExpression;

LikeRhs = LIKE Expression;

MatchRhs = MATCH REGEXP;

ContainsRhs = CONTAINS ContainsTargetExpression;

ContainsTargetExpression = (ANY ContainsArgList)
                         | (ALL ContainsArgList)
                         | REGEXP
                         | Expression;

ContainsArgList = FieldPropertyExpression | InListTargetExpression;

InTargetExpression = FieldPropertyExpression | InListTargetExpression;

InListTargetExpression = "(" ArgumentList ")";

CompareExpression = AdditiveExpression {("=" | ">" | "<" | ">=" | "<=" | "<>") AdditiveExpression};

AdditiveExpression = MultiplicativeExpression {("+" | "-") MultiplicativeExpression};

MultiplicativeExpression = NegateExpression {("*" | "/") NegateExpression};

NegateExpression = "-"? MemberExpression;

MemberExpression = BasicExpression {MemberAccessExpression | IndexExpression};

MemberAccessExpression = "." MemberFunctionExpression;

BasicExpression = LiteralExpression | ExpressionGroup | MemberFunctionExpression | IfExpression;

MemberFunctionExpression = FieldPropertyExpression | FunctionCallExpression;

FieldPropertyExpression = IDENTIFIER;

IfExpression = IF "(" Expression "," Expression "," Expression ")";

IndexExpression = "[" ArgumentList "]";

FunctionCallExpression = IDENTIFIER "(" ArgumentList? ")";

ArgumentList = Expression {"," Expression};

LiteralExpression = INTEGER | REAL | STRING_LITERAL | BooleanLiteralExpression | DATETIME | DATE | TIME;

BooleanLiteralExpression = TRUE | FALSE;

ExpressionGroup = "(" Expression ")";
